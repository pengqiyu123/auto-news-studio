# Auto News Studio - Environment Variables
# Copy this file to .env and fill in your values.

# ── LLM API Keys ──────────────────────────────────────────────
# Configure one or more LLM providers via the Settings UI at runtime.
# Alternatively, set a default key here for initial setup:
OPENROUTER_API_KEY=

# ── YouTube Data Source ────────────────────────────────────────
YOUTUBE_API_KEY=

# ── WeChat Official Account ────────────────────────────────────
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# ── Frontend API Endpoint ──────────────────────────────────────
# Only change if running backend on a different host/port
VITE_API_BASE_URL=http://127.0.0.1:8000

# ── Optional GitHub Update Check Token ─────────────────────────
# Recommended when GitHub anonymous rate limits are frequently hit.
GITHUB_TOKEN=

# ── PostgreSQL State Backend (Phase 1 scaffolding) ─────────────
# Current default remains json. Planned rollout:
# json -> dual_write -> postgres
STATE_BACKEND=json
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/auto_news_studio
